{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "publicar",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fontes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|video|marca)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/trajetoria.html",
      "destination": "/sobre.html#trajetoria",
      "permanent": true
    },
    {
      "source": "/curadoria.html",
      "destination": "/sobre.html#curadoria",
      "permanent": true
    },
    {
      "source": "/efemeros.html",
      "destination": "/encontros.html",
      "permanent": true
    },
    {
      "source": "/entrevistas.html",
      "destination": "/encontros.html#entrevistas",
      "permanent": true
    },
    {
      "source": "/presente.html",
      "destination": "/encontros.html#presente",
      "permanent": true
    },
    {
      "source": "/entreato.html",
      "destination": "/imagens.html",
      "permanent": true
    },
    {
      "source": "/acervo.html",
      "destination": "/imagens.html#acervo",
      "permanent": true
    },
    {
      "source": "/imprensa.html",
      "destination": "/textos.html#imprensa",
      "permanent": true
    },
    {
      "source": "/es/trajetoria.html",
      "destination": "/es/sobre.html#trajetoria",
      "permanent": true
    },
    {
      "source": "/es/curadoria.html",
      "destination": "/es/sobre.html#curadoria",
      "permanent": true
    },
    {
