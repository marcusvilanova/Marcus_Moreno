      "permanent": true
    },
    {
      "source": "/es/acervo.html",
      "destination": "/es/imagens.html#acervo",
      "permanent": true
    },
    {
      "source": "/es/imprensa.html",
      "destination": "/es/textos.html#imprensa",
      "permanent": true
